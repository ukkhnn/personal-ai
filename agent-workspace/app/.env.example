# Existing OpenCode credentials stay in the user's OpenCode config/auth files.
# Keep this service local. Remote/Tailscale access is a later deployment step.
PORT=4310
# WORKSPACE_DATA_DIR=/absolute/local/path/personal-ai-data
# WORKSPACE_PASSWORD=set-a-long-private-password
# OPENCODE_BIN=opencode
# To attach instead of starting a dedicated process:
# OPENCODE_URL=http://127.0.0.1:4096
# OPENCODE_SERVER_PASSWORD=your-existing-local-server-password
# OPENCODE_SERVER_USERNAME=opencode
