{
  "name": "personal-ai-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.js",
    "test": "node --test test/*.test.js",
    "check": "node --check src/main.js && node --check src/server.js && node --check public/app.js",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.js"
  }
}
