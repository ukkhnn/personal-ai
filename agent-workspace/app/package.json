{
  "name": "personal-ai-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "cli"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.js",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js && npm run typecheck && npm run lint",
    "typecheck": "tsc --noEmit && tsc -p cli/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "build:cli": "npm run build --workspace @personal-ai/workspace-cli",
    "test:cli": "npm test --workspace @personal-ai/workspace-cli",
    "test:package": "node scripts/test-cli-package.js",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.js",
    "setup:runtime": "npm ci --prefix tools/opencode --ignore-scripts --cache tools/opencode/.npm-cache --no-audit --no-fund",
    "prepare:macos": "node --env-file-if-exists=.env scripts/prepare-macos.js",
    "test:live": "node --env-file-if-exists=.env scripts/smoke-live.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  }
}
